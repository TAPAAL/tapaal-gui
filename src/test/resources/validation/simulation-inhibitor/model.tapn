<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.informatik.hu-berlin.de/top/pnml/ptNetb">
  <net id="Inhibition" type="P/T net" active="true">
    <place id="Guard" name="Guard" initialMarking="2" invariant="&lt; inf" positionX="75" positionY="180" nameOffsetX="-5" nameOffsetY="35"/>
    <place id="Supply" name="Supply" initialMarking="1" invariant="&lt; inf" positionX="75" positionY="60" nameOffsetX="-5" nameOffsetY="35"/>
    <place id="Delivered" name="Delivered" initialMarking="0" invariant="&lt; inf" positionX="420" positionY="60" nameOffsetX="-5" nameOffsetY="35"/>
    <transition id="Deliver" name="Deliver" positionX="240" positionY="60" nameOffsetY="35" urgent="false"/>
    <transition id="ClearOne" name="ClearOne" positionX="240" positionY="180" nameOffsetY="35" urgent="false"/>
    <arc id="SupplyToDeliver" source="Supply" target="Deliver" type="timed" inscription="[0,inf)" weight="1"/>
    <arc id="GuardToDeliver" source="Guard" target="Deliver" type="inhibitor" inscription="[0,inf)" weight="2"/>
    <arc id="DeliverToDelivered" source="Deliver" target="Delivered" type="normal" inscription="1" weight="1"/>
    <arc id="GuardToClearOne" source="Guard" target="ClearOne" type="timed" inscription="[0,inf)" weight="1"/>
  </net>
  <feature isTimed="true" isGame="false" isColored="false" isStochastic="false"/>
</pnml>
